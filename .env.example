# Frankonia Korea — deployment environment
#
# Copy this file to `.env` and fill in the values. `.env` is gitignored, so
# credentials stay on your machine only. `deploy/upload.py` and
# `deploy/deploy.py` load it automatically.
#
# The upload needs paramiko:  pip install paramiko

# --- SFTP target (www.frankonia-korea.com document root) ---
SFTP_HOST=
SFTP_USER=
SFTP_PASS=
SFTP_REMOTE=/public_html

# --- Production build ---
# Consumed by `next build` when running `deploy/deploy.py`. The base path is
# empty because the production site serves from the domain root, unlike the
# GitHub Pages staging build which serves from /Frankonia-Korea.
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_SITE_ORIGIN=https://www.frankonia-korea.com
# Search engines are only let in on the real domain. Leave this unset for any
# build that is not going to www.frankonia-korea.com.
NEXT_PUBLIC_INDEXABLE=1
