# Apache config for www.frankonia-korea.com
# Uploaded to the document root as .htaccess by deploy/upload.py.
# Lives outside public/ so a rebuild cannot drop it.

Options -Indexes
DirectoryIndex index.html

RewriteEngine On

# Canonical host. HTTPS is already enforced by the hosting platform, so this
# only normalises the hostname; requests that already match are left alone,
# which keeps the rule from looping.
RewriteCond %{HTTP_HOST} !^www\.frankonia-korea\.com$ [NC]
RewriteCond %{HTTP_HOST} !^$
RewriteRule ^(.*)$ https://www.frankonia-korea.com/$1 [R=301,L]

# Route parents are not pages. `/company/philosophy/` is exported, `/company/`
# is not — it exists on disk only as the directory holding the five sections,
# and the same is true of /chambers/type/, /test-systems/product/ and the rest,
# in both locales. Nothing on the site links to them, but a reader who trims a
# URL back reaches one, and `Options -Indexes` answers that with a bare Apache
# 403. Answer 404 instead: it is what the path is, and it hands the reader the
# site's own 404 page through the line below.
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html !-f
RewriteRule ^ - [R=404,L]

ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Two years, preload-eligible. Only safe once the whole site is HTTPS and
  # no plain-HTTP subdomain is left serving.
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), interest-cohort=()"
  # The site is static and now entirely first-party: the typefaces are built
  # into the export (app/fonts.ts), so the Google exceptions this policy used
  # to carry for style-src and font-src are gone and nothing here reaches off
  # the origin. 'unsafe-inline' stays for the framework's own bootstrap script
  # and for next/font's @font-face block, neither of which can carry a nonce
  # in a static export. frame-ancestors repeats X-Frame-Options for modern
  # browsers.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; media-src 'self'; connect-src 'self'; form-action 'self' mailto:; frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
</IfModule>

<IfModule mod_brotli.c>
  # Preferred over gzip where the client offers it: ~15% smaller on the
  # framework bundles. Wrapped in IfModule because the module is not enabled on
  # every Apache build — where it is missing, mod_deflate below still runs.
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain text/xml \
    text/javascript application/javascript application/json application/xml \
    image/svg+xml
</IfModule>

<IfModule mod_deflate.c>
  # `text/javascript` is the entry that matters and the one that was missing.
  # Apache 2.4.55 and later serve .js under that type, not the older
  # `application/javascript` — so every chunk Next emits was going out
  # uncompressed: ~640 KB of script per cold page load instead of ~200 KB.
  # Both types are listed because the mime mapping differs by Apache version
  # and neither costs anything when it does not match.
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
    text/javascript application/javascript application/json application/xml \
    image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  # Build assets carry a content hash, so they can be cached indefinitely.
  ExpiresByType text/css                 "access plus 1 year"
  ExpiresByType text/javascript          "access plus 1 year"
  ExpiresByType application/javascript   "access plus 1 year"
  # The typefaces are hashed build assets too, and had no rule at all: every
  # navigation re-validated each woff2 the page touched. Korean is split across
  # many unicode-range files, so that was several round trips per page.
  ExpiresByType font/woff2               "access plus 1 year"
  ExpiresByType font/woff                "access plus 1 year"
  ExpiresByType image/svg+xml            "access plus 6 months"
  ExpiresByType image/jpeg               "access plus 6 months"
  ExpiresByType image/png                "access plus 6 months"
  ExpiresByType image/webp               "access plus 6 months"
  ExpiresByType video/mp4                "access plus 6 months"
  ExpiresByType application/pdf          "access plus 1 month"
  # Pages must revalidate so a redeploy is picked up immediately.
  ExpiresByType text/html                "access plus 0 seconds"
  ExpiresByType application/xml          "access plus 1 hour"
  ExpiresByType text/plain               "access plus 1 hour"
  ExpiresByType image/x-icon             "access plus 1 week"
  ExpiresByType image/vnd.microsoft.icon "access plus 1 week"
</IfModule>

<IfModule mod_headers.c>
  # Every script, stylesheet and typeface in the export is a build asset named
  # by content hash, and all of them live under /_next/static/ — nothing else
  # in the document root carries these extensions, which is what makes matching
  # on the extension safe. A changed file gets a changed name, so the browser
  # never needs to ask whether its copy is current; `immutable` is what says
  # so. Without it a reload re-validates every chunk and every typeface, which
  # is the one round trip a returning reader should never pay.
  #
  # Matching on the name rather than on the path (`<If "%{REQUEST_URI} =~ …">`)
  # on purpose: `<If>` needs `AllowOverride All`, and where the host has not
  # granted it Apache answers the whole site with a 500. FilesMatch needs only
  # the FileInfo override the Header lines above already rely on.
  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # The RSC payloads the client router fetches when it navigates. These are
  # pages by another name — same content, same need to be current after a
  # deploy — so they follow the HTML rule rather than the `text/plain` one,
  # which would otherwise hold a stale copy of a page for an hour. `no-cache`
  # still allows a conditional request, so an unchanged payload costs a 304 and
  # not a re-download; the prefetch has usually paid for it before the click.
  <FilesMatch "\.txt$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
