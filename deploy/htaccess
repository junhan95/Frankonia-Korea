# Apache config for www.frankonia-korea.com
# Uploaded to the document root as .htaccess by deploy/upload.py.
# Lives outside public/ so a rebuild cannot drop it.

Options -Indexes
DirectoryIndex index.html

RewriteEngine On

# Canonical host. HTTPS is already enforced by the hosting platform, so this
# only normalises the hostname; requests that already match are left alone,
# which keeps the rule from looping.
RewriteCond %{HTTP_HOST} !^www\.frankonia-korea\.com$ [NC]
RewriteCond %{HTTP_HOST} !^$
RewriteRule ^(.*)$ https://www.frankonia-korea.com/$1 [R=301,L]

ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Two years, preload-eligible. Only safe once the whole site is HTTPS and
  # no plain-HTTP subdomain is left serving.
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), interest-cohort=()"
  # The site is static: scripts and styles are first-party, fonts come from
  # Google. frame-ancestors repeats X-Frame-Options for modern browsers.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; form-action 'self' mailto:; frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
    application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  # Build assets carry a content hash, so they can be cached indefinitely.
  ExpiresByType text/css                 "access plus 1 year"
  ExpiresByType application/javascript   "access plus 1 year"
  ExpiresByType image/svg+xml            "access plus 6 months"
  ExpiresByType image/jpeg               "access plus 6 months"
  ExpiresByType image/png                "access plus 6 months"
  ExpiresByType image/webp               "access plus 6 months"
  ExpiresByType application/pdf          "access plus 1 month"
  # Pages must revalidate so a redeploy is picked up immediately.
  ExpiresByType text/html                "access plus 0 seconds"
  ExpiresByType application/xml          "access plus 1 hour"
  ExpiresByType text/plain               "access plus 1 hour"
  ExpiresByType image/x-icon             "access plus 1 week"
  ExpiresByType image/vnd.microsoft.icon "access plus 1 week"
</IfModule>
